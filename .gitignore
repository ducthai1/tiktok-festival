# token điều khiển + cài đặt máy này: không bao giờ commit
data/*
!data/.gitkeep
# dữ liệu tài khoản thứ 2, 3… (DATA_DIR=data-acc2 …)
data-*/
.env
*.log

# ảnh thô tải về để xử lý + asset có giấy phép không cho phát hành công khai (Mixamo): chỉ để trên máy
art-inbox/
public/assets-local/

# video DJ của chủ kênh cho Sàn Nhảy (file lớn, không đưa lên git)
public/assets/dance/dj/

# nhạc nền Sàn Nhảy (file lớn, tải lại theo public/assets/dance/music/NGUON-NHAC.txt)
public/assets/dance/music/*.mp3
public/assets/dance/sfx/*.mp3
