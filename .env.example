# Sao chép file này thành .env rồi điền giá trị (file .env không được commit lên git)
#
# EULER_API_KEY — bắt buộc nếu TikTok chặn kết nối trực tiếp
#   Lấy key miễn phí tại: https://www.eulerstream.com
#   Plan Free đủ để fetchRoomId (kết nối live). Business mới cần để fetchAvailableGifts.
EULER_API_KEY=

# PORT — cổng server (mặc định 3939)
# PORT=3939

# TIKTOK_USERNAME — tự kết nối khi khởi động (không cần bấm thêm trên trang admin)
# TIKTOK_USERNAME=tangducne

# ALLOW_LAN=1 — cho điện thoại cùng wifi mở trang điều khiển (vẫn cần token)
# ALLOW_LAN=1
