{
  "name": "tiktok-live-games",
  "version": "0.1.0",
  "private": true,
  "description": "Hai game tương tác cho TikTok LIVE (Quán Bar 3D, Đua Bơi 3D) chạy trên một server, đổi game ngay khi đang live",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test \"test/*.test.js\"",
    "gate": "npm run check && npm test",
    "rotate-token": "node scripts/rotate-admin-token.mjs",
    "untrack-data": "node scripts/untrack-live-data.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "tiktok-live-connector": "2.5.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "ws": "8.22.0",
    "follow-redirects": "1.16.2"
  }
}
